# Telegram
BOT_TOKEN=your_bot_token_from_botfather

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=balandda
DB_USER=balandda
DB_PASSWORD=change_me_in_production

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Reports
DAILY_REPORT_HOUR=21
DAILY_REPORT_MINUTE=0
TIMEZONE=Asia/Tashkent

# Owner digests (morning bookings/money/wallets summary; evening uses DAILY_REPORT_HOUR)
OWNER_DIGEST_MORNING_HOUR=9
OWNER_DIGEST_MORNING_MINUTE=0
# Extra Telegram IDs (comma-separated) that also receive digests + /svodka
OWNER_DIGEST_EXTRA_IDS=548813671

# Admin Telegram user ID (get via @userinfobot)
ADMIN_USER_ID=

# Billz POS (XUSH retail)
BILLZ_API_KEY=
BILLZ_SKLAD_API_KEY=

# iikoServer (RMS) — restaurant revenue (address like https://balandda.iiko.it)
IIKO_SERVER_URL=
IIKO_SERVER_LOGIN=
IIKO_SERVER_PASSWORD=
# Wallet that receives daily iiko cash revenue (0 = disabled)
IIKO_CASH_WALLET_ID=1016986741

# Beds24 channel manager (OTA sync: Booking.com / Airbnb / Trip.com)
BEDS24_ENABLED=false
BEDS24_REFRESH_TOKEN=
BEDS24_PROPERTY_ID=340623
BEDS24_MARKUP_PERCENT=20
# UZS/USD: 0 = auto (official CBU rate, cached 6h); set a number to override manually
BEDS24_USD_RATE=0
BEDS24_SYNC_DAYS=365

# Card monitoring (CardXabar / UZCARD via read-only Telethon userbot)
# Create the session with: python scripts/telethon_login.py  (on your PC)
TELETHON_API_ID=0
TELETHON_API_HASH=
TELETHON_SESSION=
CARDXABAR_CHAT=CardXabar
# last4:BUSINESS pairs (BALANDDA or XUSH)
CARD_MAP=4042:BALANDDA,8044:XUSH
CARD_RECON_HOUR=21
CARD_RECON_MINUTE=15
